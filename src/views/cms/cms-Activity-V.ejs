<%- include('../parts/head') %>

<!-- Página de visualização: usada ao abrir em nova aba ou por link direto.
     Nas telas de Atividades e Calendário, a visualização abre em pop-up. -->
<main class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-2 mr-3">Atividade nº <%= activity.id %></h1>
        <div class="d-flex flex-wrap align-items-center mb-2">
            <% if (can('activities', 'delete')) { %>
            <button type="button" class="btn btn-sm btn-outline-danger mr-1 mb-1" data-toggle="modal" data-target="#deleteModal"
                title="Excluir Atividade" aria-label="Excluir Atividade">
                <i class="fas fa-trash-alt mr-1" aria-hidden="true"></i> Excluir
            </button>
            <% } %>
            <% if (can('activities', 'update')) { %>
            <a class="btn btn-sm btn-outline-primary mr-1 mb-1" href="/cms-Activity-U/<%= activity.id %>"
                title="Editar Atividade" aria-label="Editar Atividade">
                <i class="fas fa-pen mr-1" aria-hidden="true"></i> Editar
            </a>
            <% } %>
            <a class="btn btn-sm btn-outline-secondary mb-1" href="/cms-Activity-Q"
                title="Voltar à Lista" aria-label="Voltar à Lista">
                <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
            </a>
        </div>
    </div>

    <%- include('cms-Activity-V-details', { activity }) %>

    <%- include('cms-Activity-D', { activityId: activity.id }) %>
</main>

<script src="/scripts/sphere-colors.js" defer></script>

<%- include('../parts/footer') %>
