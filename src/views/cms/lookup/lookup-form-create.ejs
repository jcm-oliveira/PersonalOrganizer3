<%- include('../../parts/head') %>

<main class="container py-4">
    <form method="post" action="/<%= routePrefix %>-C">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">Novo(a) <%= entityName %></h1>
            <div class="d-flex align-items-center">
                <button type="submit" class="btn btn-sm btn-primary mr-1"
                    title="Salvar" aria-label="Salvar">
                    <i class="fas fa-save mr-1" aria-hidden="true"></i> Salvar
                </button>
                <a class="btn btn-sm btn-outline-secondary" href="/<%= routePrefix %>-Q"
                    title="Voltar à Lista" aria-label="Voltar à Lista">
                    <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
                </a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group col-md-<%= (routePrefix === 'cms-LifeSphere' || routePrefix === 'cms-ActivityStatus') ? (routePrefix === 'cms-ActivityStatus' ? '4' : '6') : '8' %>">
                        <label for="name">
                            <i class="fas fa-tag text-muted mr-1" aria-hidden="true"></i> Nome <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control <%= errors.name ? 'is-invalid' : '' %>"
                            id="name" name="name" value="<%= values.name || '' %>" required autofocus
                            placeholder="Informe o nome...">
                        <% if (errors.name) { %><div class="invalid-feedback"><%= errors.name %></div><% } %>
                    </div>

                    <% if (routePrefix === 'cms-LifeSphere') { %>
                        <div class="form-group col-md-3">
                            <label for="color_code">
                                <i class="fas fa-palette text-muted mr-1" aria-hidden="true"></i> Cor da Linha (HTML)
                            </label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" style="max-width: 50px; padding: 0.2rem;"
                                    id="color_picker" value="<%= values.color_code || '#007bff' %>"
                                    onchange="document.getElementById('color_code').value = this.value">
                                <input type="text" class="form-control <%= errors.color_code ? 'is-invalid' : '' %>"
                                    id="color_code" name="color_code" value="<%= values.color_code || '#007bff' %>"
                                    placeholder="#007bff" oninput="document.getElementById('color_picker').value = this.value">
                            </div>
                            <% if (errors.color_code) { %><div class="invalid-feedback d-block"><%= errors.color_code %></div><% } %>
                        </div>
                    <% } else if (routePrefix === 'cms-ActivityStatus') { %>
                        <div class="form-group col-md-3">
                            <label for="color_code">
                                <i class="fas fa-palette text-muted mr-1" aria-hidden="true"></i> Cor do Texto (HTML)
                            </label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" style="max-width: 50px; padding: 0.2rem;"
                                    id="color_picker" value="<%= values.color_code || '#212529' %>"
                                    onchange="document.getElementById('color_code').value = this.value">
                                <input type="text" class="form-control <%= errors.color_code ? 'is-invalid' : '' %>"
                                    id="color_code" name="color_code" value="<%= values.color_code || '#212529' %>"
                                    placeholder="#212529" oninput="document.getElementById('color_picker').value = this.value">
                            </div>
                            <% if (errors.color_code) { %><div class="invalid-feedback d-block"><%= errors.color_code %></div><% } %>
                        </div>

                        <div class="form-group col-md-3">
                            <label for="visibility">
                                <i class="fas fa-eye text-muted mr-1" aria-hidden="true"></i> Visibilidade
                            </label>
                            <select class="form-control <%= errors.visibility ? 'is-invalid' : '' %>" id="visibility" name="visibility">
                                <option value="1" <%= values.visibility === "0" ? "" : "selected" %>>Visível por padrão</option>
                                <option value="0" <%= values.visibility === "0" ? "selected" : "" %>>Oculto por padrão</option>
                            </select>
                            <small class="form-text text-muted">Aparece na tela de consulta ou apenas via filtro.</small>
                            <% if (errors.visibility) { %><div class="invalid-feedback"><%= errors.visibility %></div><% } %>
                        </div>
                    <% } %>

                    <div class="form-group col-md-<%= (routePrefix === 'cms-ActivityStatus') ? '2' : (routePrefix === 'cms-LifeSphere' ? '3' : '4') %>">
                        <label for="status">
                            <i class="fas fa-toggle-on text-muted mr-1" aria-hidden="true"></i> Status
                        </label>
                        <select class="form-control <%= errors.status ? 'is-invalid' : '' %>" id="status" name="status">
                            <option value="1" <%= values.status === "1" ? "selected" : "" %>>Ativo</option>
                            <option value="0" <%= values.status === "0" ? "selected" : "" %>>Inativo</option>
                        </select>
                        <% if (errors.status) { %><div class="invalid-feedback"><%= errors.status %></div><% } %>
                    </div>
                </div>

                <div class="form-group mb-0">
                    <label for="description">
                        <i class="fas fa-align-left text-muted mr-1" aria-hidden="true"></i> Descrição
                    </label>
                    <textarea class="form-control <%= errors.description ? 'is-invalid' : '' %>"
                        id="description" name="description" rows="3"
                        placeholder="Detalhes ou orientações..."><%= values.description || '' %></textarea>
                    <% if (errors.description) { %><div class="invalid-feedback"><%= errors.description %></div><% } %>
                </div>
            </div>
        </div>
    </form>
</main>

<%- include('../../parts/footer') %>
