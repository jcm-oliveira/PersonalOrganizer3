<%- include('../parts/head') %>

<main class="container-fluid py-4 px-lg-5">
    <!-- Barra de Ações (Filtros e Novo) -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0 text-dark">Atividades</h1>
            <% if (filter.trafficLight || filter.search || filter.lifeSphere || filter.relevance || filter.actionType || filter.status !== 'visible') { %>
                <span class="badge badge-info mt-1">Filtros aplicados</span>
                <a href="/cms-Activity-Q" class="small text-danger ml-2">Limpar filtros</a>
            <% } %>
        </div>
        <div class="d-flex align-items-center">
            <% const hasActiveFilter = Boolean(filter.trafficLight || filter.search || filter.lifeSphere || filter.relevance || filter.actionType || filter.status !== 'visible'); %>
            <button type="button" class="btn btn-sm <%= hasActiveFilter ? 'btn-primary' : 'btn-outline-secondary' %> mr-1"
                data-toggle="modal" data-target="#filterModal" title="Filtrar atividades" aria-label="Filtrar atividades">
                <i class="fas fa-filter" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary mr-1" onclick="window.print()"
                title="Imprimir" aria-label="Imprimir">
                <i class="fas fa-print" aria-hidden="true"></i>
            </button>
            <a class="btn btn-sm btn-outline-primary" href="/cms-Activity-C"
                title="Nova Atividade" aria-label="Nova Atividade">
                <i class="fas fa-plus" aria-hidden="true"></i>
            </a>
        </div>
    </div>

    <%- include('../parts/messages') %>

    <!-- Tabela Estilo Planilha / Painel de Vôo -->
    <div class="table-responsive shadow-sm bg-white rounded">
        <table class="table table-sm table-bordered table-hover table-activity mb-0">
            <thead>
                <!-- Linha superior de agrupamento de cabeçalho -->
                <tr class="table-activity-group">
                    <th colspan="5" class="text-left px-3">INFORMAÇÕES OBRIGATÓRIAS</th>
                    <th colspan="5" class="text-left px-3">INFORMAÇÕES COMPLEMENTARES</th>
                    <th colspan="1" class="text-center">STATUS</th>
                    <th colspan="3" class="text-center">FAROL</th>
                    <th colspan="1" class="text-center">AÇÕES</th>
                </tr>
                <!-- Linha inferior de colunas específicas com ícones acima dos textos -->
                <tr class="text-center">
                    <th style="min-width: 220px;" class="text-left">
                        <span class="activity-th-content activity-th-content--left">
                            <i class="fas fa-align-left activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Descrição</span>
                        </span>
                    </th>
                    <th style="min-width: 130px;">
                        <span class="activity-th-content">
                            <i class="fas fa-heart activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Esfera da Vida</span>
                        </span>
                    </th>
                    <th style="min-width: 95px;">
                        <span class="activity-th-content">
                            <i class="fas fa-flag activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Relevância</span>
                        </span>
                    </th>
                    <th style="min-width: 110px;">
                        <span class="activity-th-content">
                            <i class="far fa-calendar-alt activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Próxima Atividade</span>
                        </span>
                    </th>
                    <th style="min-width: 100px;">
                        <span class="activity-th-content">
                            <i class="far fa-calendar-check activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Prazo Final</span>
                        </span>
                    </th>

                    <th style="min-width: 105px;">
                        <span class="activity-th-content">
                            <i class="fas fa-sun activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Período do dia</span>
                        </span>
                    </th>
                    <th style="min-width: 75px;">
                        <span class="activity-th-content">
                            <i class="far fa-clock activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Horário</span>
                        </span>
                    </th>
                    <th style="min-width: 95px;">
                        <span class="activity-th-content">
                            <i class="fas fa-redo-alt activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Periodicidade</span>
                        </span>
                    </th>
                    <th style="min-width: 110px;">
                        <span class="activity-th-content">
                            <i class="fas fa-layer-group activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Tipo de Ação</span>
                        </span>
                    </th>
                    <th style="min-width: 150px;">
                        <span class="activity-th-content">
                            <i class="fas fa-folder activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Organização por tema</span>
                        </span>
                    </th>

                    <th style="min-width: 75px;">
                        <span class="activity-th-content">
                            <i class="fas fa-toggle-on activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Status</span>
                        </span>
                    </th>
                    <th style="min-width: 70px;">
                        <span class="activity-th-content">
                            <i class="fas fa-stopwatch activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Dias próx.</span>
                        </span>
                    </th>
                    <th style="min-width: 70px;">
                        <span class="activity-th-content">
                            <i class="fas fa-hourglass-half activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Dias prazo</span>
                        </span>
                    </th>
                    <th style="min-width: 115px;">
                        <span class="activity-th-content">
                            <i class="fas fa-calendar-day activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Dia Próx.</span>
                        </span>
                    </th>
                    <th style="min-width: 170px;">
                        <span class="activity-th-content">
                            <i class="fas fa-tools activity-th-icon" aria-hidden="true"></i>
                            <span class="activity-th-label">Ações</span>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                <% if (activities.length === 0) { %>
                    <tr>
                        <td colspan="15" class="text-center py-4 text-muted">
                            Nenhuma atividade encontrada com os filtros selecionados.
                        </td>
                    </tr>
                <% } %>
                <% activities.forEach((act) => { 
                    const isOverdue = act.traffic_light === 'ATRASADA';
                    // A cor da Esfera da Vida sempre prevalece, independente de data ou atraso
                    const hasSphereColor = Boolean(act.life_sphere_color);
                    const rowClass = hasSphereColor ? 'activity-row--sphere' : (isOverdue ? 'table-danger' : '');
                %>
                    <tr class="<%= rowClass %>"
                        <% if (hasSphereColor) { %>data-bg-color="<%= act.life_sphere_color %>" data-text-color="<%= act.life_sphere_text_color %>"<% } %>>
                        <!-- Descrição (destaque em negrito) -->
                        <td class="align-middle text-left">
                            <a href="/cms-Activity-V/<%= act.id %>" class="activity-desc-link">
                                <%= act.description %>
                            </a>
                        </td>

                        <!-- Esfera da Vida -->
                        <td class="align-middle text-center">
                            <%= act.life_sphere %>
                        </td>

                        <!-- Relevância -->
                        <td class="align-middle text-center">
                            <%= act.relevance %>
                        </td>

                        <!-- Próxima Atividade -->
                        <td class="align-middle text-center">
                            <%= act.next_activity_date_formatted || '-' %>
                        </td>

                        <!-- Prazo Final -->
                        <td class="align-middle text-center">
                            <%= act.final_deadline_formatted || '-' %>
                        </td>

                        <!-- Período do dia -->
                        <td class="align-middle text-center">
                            <%= act.day_period || '-' %>
                        </td>

                        <!-- Horário -->
                        <td class="align-middle text-center">
                            <%= act.scheduled_time ? act.scheduled_time.slice(0, 5) : '-' %>
                        </td>

                        <!-- Periodicidade -->
                        <td class="align-middle text-center">
                            <%= act.periodicity || '-' %>
                        </td>

                        <!-- Tipo de Ação -->
                        <td class="align-middle text-center">
                            <%= act.action_type || '-' %>
                        </td>

                        <!-- Organização por tema -->
                        <td class="align-middle text-center">
                            <%= act.theme_organization || '-' %>
                        </td>

                        <!-- Status -->
                        <td class="align-middle text-center">
                            <span class="badge activity-status-badge" style="background-color: <%= act.status_color_code %>; color: <%= act.status_text_color %>;">
                                <%= act.status_name || (act.status === 1 ? 'Ativo' : 'Inativo') %>
                            </span>
                        </td>

                        <!-- Dias Próx. Atividade com indicador circular (dot) -->
                        <td class="align-middle text-center">
                            <span class="d-inline-block rounded-circle mr-1" style="width: 8px; height: 8px; background-color: <%= act.traffic_light_dot_color %>;"></span>
                            <%= act.days_next_activity !== null ? act.days_next_activity : '-' %>
                        </td>

                        <!-- Dias Prazo Final -->
                        <td class="align-middle text-center">
                            <%= act.days_final_deadline !== null ? act.days_final_deadline : '-' %>
                        </td>

                        <!-- Dia Próx. Atividade (ATRASADO, HOJE, AMANHÃ, dia da semana ou MAIS DE 15 DIAS) -->
                        <td class="align-middle text-center font-weight-bold">
                            <span class="badge <%= act.traffic_light_class %>">
                                <%= act.next_activity_day_label %>
                            </span>
                        </td>

                        <!-- Ações (botões compactos de ícones nos moldes de Projetos) -->
                        <td class="align-middle text-center text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary mr-1" href="/cms-Activity-V/<%= act.id %>"
                                title="Visualizar atividade" aria-label="Visualizar atividade">
                                <i class="fas fa-search" aria-hidden="true"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-primary mr-1" href="/cms-Activity-U/<%= act.id %>"
                                title="Editar atividade" aria-label="Editar atividade">
                                <i class="fas fa-pen" aria-hidden="true"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-primary mr-1"
                                data-toggle="modal" data-target="#rescheduleModal"
                                data-activity-id="<%= act.id %>"
                                data-activity-description="<%= act.description %>"
                                data-next-date="<%= act.next_activity_date_formatted || '' %>"
                                title="Remarcar atividade" aria-label="Remarcar atividade">
                                <i class="far fa-calendar-alt" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                data-toggle="modal" data-target="#statusModal"
                                data-activity-id="<%= act.id %>"
                                data-activity-description="<%= act.description %>"
                                data-status="<%= act.status %>"
                                title="Status da atividade" aria-label="Status da atividade">
                                <i class="fas fa-toggle-on" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Paginação -->
    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginação">
        <span class="text-muted small">
            Exibindo <%= pagination.firstItem %>–<%= pagination.lastItem %> de <%= pagination.total %> registros
        </span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pagination.previousUrl ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.previousUrl || '#' %>">Anterior</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página <%= pagination.page %> de <%= pagination.totalPages %></span>
            </li>
            <li class="page-item <%= pagination.nextUrl ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.nextUrl || '#' %>">Próxima</a>
            </li>
        </ul>
    </nav>

    <!-- Modal de Filtros -->
    <%- include('cms-Activity-F') %>

    <!-- Pop-ups de ações rápidas -->
    <%- include('cms-Activity-R') %>
    <%- include('cms-Activity-S') %>
</main>

<script src="/scripts/sphere-colors.js" defer></script>
<script src="/scripts/activity-quick-actions.js" defer></script>

<%- include('../parts/footer') %>
