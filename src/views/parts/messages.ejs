<%# Mensagem após uma ação (salvar, excluir...): com "×" para fechar e fechada sozinha
    após 5 segundos (public/scripts/flash-messages.js) %>
<% if (locals.message) { %>
    <div class="alert <%= message.alertType %> alert-dismissible fade show" role="alert" data-auto-dismiss="5000">
        <%= message.text %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Fechar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>
