<!-- Confirmação de exclusão (preenchida por /scripts/confirm-delete.js a partir de
     data-delete-action e data-delete-name do botão clicado) -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form class="modal-content" method="post" action="">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteTitle">Confirmar exclusão</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir <%= entityLabel %> <strong data-field="delete-name"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Não</button>
                <button type="submit" class="btn btn-danger">Sim, excluir</button>
            </div>
        </form>
    </div>
</div>
