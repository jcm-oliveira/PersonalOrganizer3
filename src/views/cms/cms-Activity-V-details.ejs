<%#
    Detalhes da atividade: usado na página de visualização (cms-Activity-V) e no
    pop-up de visualização (cms-Activity-V-modal, carregado em /cms-Activity-V/:id/detalhes).
    Sem style="" inline (bloqueado pela CSP): as cores vêm de data-* e são aplicadas
    por /scripts/sphere-colors.js.
%>
<div class="activity-view-badges mb-3">
    <span class="badge badge-pill color-badge"
        data-bg-color="<%= activity.status_color_code %>" data-text-color="auto">
        <%= activity.status_name || (activity.status === 1 ? 'Ativo' : 'Inativo') %>
    </span>
    <span class="badge badge-pill <%= activity.traffic_light_class %> ml-1">
        <%= activity.next_activity_day_label %>
    </span>
    <% if (activity.recurrence_description) { %>
        <span class="badge badge-pill badge-light border ml-1">
            <i class="fas fa-redo-alt mr-1" aria-hidden="true"></i> Recorrente
        </span>
    <% } %>
</div>

<div class="row">
    <!-- Informações Obrigatórias -->
    <div class="col-lg-6 mb-3">
        <div class="card h-100">
            <div class="card-header bg-light font-weight-bold">
                <i class="fas fa-check-circle text-primary mr-1" aria-hidden="true"></i> Informações Obrigatórias
            </div>
            <div class="card-body">
                <dl class="row mb-0 activity-view-list">
                    <dt class="col-sm-5 text-muted">Esfera da Vida:</dt>
                    <dd class="col-sm-7 font-weight-bold">
                        <% if (activity.life_sphere_color) { %>
                            <span class="color-dot mr-1" data-bg-color="<%= activity.life_sphere_color %>" aria-hidden="true"></span>
                        <% } %>
                        <%= activity.life_sphere %>
                    </dd>

                    <dt class="col-sm-5 text-muted">Descrição:</dt>
                    <dd class="col-sm-7"><%= activity.description %></dd>

                    <dt class="col-sm-5 text-muted">Relevância:</dt>
                    <dd class="col-sm-7">
                        <span class="badge badge-info"><%= activity.relevance %></span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Próxima Atividade:</dt>
                    <dd class="col-sm-7 font-weight-bold">
                        <%= activity.next_activity_date_br || '-' %>
                        <% if (activity.days_next_activity !== null) { %>
                            <span class="small font-weight-normal <%= activity.days_next_activity < 0 ? 'text-danger' : 'text-muted' %>">
                                (<%= activity.days_next_activity %> dias)
                            </span>
                        <% } %>
                    </dd>

                    <dt class="col-sm-5 text-muted">Prazo Final:</dt>
                    <dd class="col-sm-7">
                        <%= activity.final_deadline_br || '-' %>
                        <% if (activity.days_final_deadline !== null) { %>
                            <span class="small text-muted">(<%= activity.days_final_deadline %> dias)</span>
                        <% } %>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Informações Complementares -->
    <div class="col-lg-6 mb-3">
        <div class="card h-100">
            <div class="card-header bg-light font-weight-bold">
                <i class="fas fa-info-circle text-primary mr-1" aria-hidden="true"></i> Informações Complementares
            </div>
            <div class="card-body">
                <dl class="row mb-0 activity-view-list">
                    <dt class="col-sm-5 text-muted">Período do Dia:</dt>
                    <dd class="col-sm-7"><%= activity.day_period || '-' %></dd>

                    <dt class="col-sm-5 text-muted">Horário:</dt>
                    <dd class="col-sm-7"><%= activity.scheduled_time ? activity.scheduled_time.slice(0, 5) : '-' %></dd>

                    <dt class="col-sm-5 text-muted">Repetição:</dt>
                    <dd class="col-sm-7">
                        <% if (activity.recurrence_description) { %>
                            <i class="fas fa-redo-alt text-muted mr-1" aria-hidden="true"></i>
                            <%= activity.recurrence_description %>
                            <% if (activity.next_occurrence_date) { %>
                                <span class="d-block small text-muted">
                                    Ocorrência seguinte: <%= activity.next_occurrence_date.split('-').reverse().join('/') %>
                                </span>
                            <% } %>
                        <% } else { %>
                            Não se repete
                        <% } %>
                    </dd>

                    <dt class="col-sm-5 text-muted">Tipo de Ação:</dt>
                    <dd class="col-sm-7"><%= activity.action_type || '-' %></dd>

                    <dt class="col-sm-5 text-muted">Organização por Tema:</dt>
                    <dd class="col-sm-7"><%= activity.theme_organization || '-' %></dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Anotações -->
<div class="card mb-0">
    <div class="card-header bg-light font-weight-bold">
        <i class="fas fa-sticky-note text-primary mr-1" aria-hidden="true"></i> Anotações / Próximas Atividades
    </div>
    <div class="card-body">
        <p class="mb-0 activity-notes"><%= activity.notes || 'Nenhuma anotação registrada.' %></p>
    </div>
</div>
