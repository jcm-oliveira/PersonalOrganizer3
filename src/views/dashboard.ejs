<%- include('parts/head') %>

<main class="container py-4">
    <!-- Cabeçalho no padrão das telas de consulta: botões pequenos só com ícone -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1 text-dark">Dashboard</h1>
            <p class="text-muted mb-0">Visão geral e status das atividades em andamento.</p>
        </div>
        <div class="d-flex align-items-center flex-shrink-0 ml-2">
            <% if (can('activities', 'view')) { %>
            <a class="btn btn-sm btn-outline-secondary mr-1" href="/cms-Activity-Q"
                title="Gerenciar Atividades" aria-label="Gerenciar Atividades">
                <i class="fas fa-tasks" aria-hidden="true"></i>
            </a>
            <% } %>
            <% if (can('calendar', 'view')) { %>
            <a class="btn btn-sm btn-outline-secondary mr-1" href="/cms-Calendar"
                title="Calendário" aria-label="Calendário">
                <i class="far fa-calendar-alt" aria-hidden="true"></i>
            </a>
            <% } %>
            <% if (can('activities', 'create')) { %>
            <a class="btn btn-sm btn-outline-primary" href="/cms-Activity-C"
                title="Nova Atividade" aria-label="Nova Atividade">
                <i class="fas fa-plus" aria-hidden="true"></i>
            </a>
            <% } %>
        </div>
    </div>

    <!-- Quadrante com Status das Atividades -->
    <div class="row">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light font-weight-bold d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-chart-pie text-primary mr-1" aria-hidden="true"></i> Status das Atividades</span>
                    <% if (can('activities', 'view')) { %>
                    <a href="/cms-Activity-Q" class="small text-primary">Ver todas</a>
                    <% } %>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm table-hover mb-0">
                        <tbody>
                            <tr>
                                <td class="px-3 py-2">
                                    <a href="/cms-Activity-Q?trafficLight=PRAZO" class="text-dark">Prazo Final em 7 dias</a>
                                </td>
                                <td class="text-right px-3 py-2 font-weight-bold text-danger"><%= stats.prazoFinal7Dias %></td>
                            </tr>
                            <tr>
                                <td class="px-3 py-2">
                                    <span class="d-inline-block rounded-circle mr-2" style="width: 10px; height: 10px; background-color: #343a40;"></span>
                                    <a href="/cms-Activity-Q?trafficLight=ATRASADA" class="text-dark">Atividades vencidas</a>
                                </td>
                                <td class="text-right px-3 py-2 font-weight-bold text-danger"><%= stats.vencidas %></td>
                            </tr>
                            <tr>
                                <td class="px-3 py-2">
                                    <span class="d-inline-block rounded-circle mr-2" style="width: 10px; height: 10px; background-color: #fd7e14;"></span>
                                    <a href="/cms-Activity-Q?trafficLight=7_DIAS" class="text-dark">Atividades nos próximos 7 dias</a>
                                </td>
                                <td class="text-right px-3 py-2 font-weight-bold"><%= stats.proximos7Dias %></td>
                            </tr>
                            <tr>
                                <td class="px-3 py-2">
                                    <span class="d-inline-block rounded-circle mr-2" style="width: 10px; height: 10px; background-color: #ffc107;"></span>
                                    <a href="/cms-Activity-Q?trafficLight=15_DIAS" class="text-dark">Atividades entre 7 e 15 dias</a>
                                </td>
                                <td class="text-right px-3 py-2 font-weight-bold"><%= stats.entre7e15Dias %></td>
                            </tr>
                            <%# Tipos de Atividade (os mesmos blocos da consulta) %>
                            <tr>
                                <td class="px-3 py-2">
                                    <span class="d-inline-block rounded-circle mr-2" style="width: 10px; height: 10px; background-color: #28a745;"></span>
                                    <a href="/cms-Activity-L?activityType=<%= encodeURIComponent('Programada') %>" class="text-dark">Atividades Programadas</a>
                                </td>
                                <td class="text-right px-3 py-2 font-weight-bold text-success"><%= stats.programadas %></td>
                            </tr>
                            <tr>
                                <td class="px-3 py-2">
                                    <a href="/cms-Activity-L?activityType=<%= encodeURIComponent('Ordem de Serviço') %>" class="text-dark">Ordens de Serviço</a>
                                </td>
                                <td class="text-right px-3 py-2 font-weight-bold"><%= stats.ordensServico %></td>
                            </tr>
                            <tr>
                                <td class="px-3 py-2">
                                    <a href="/cms-Activity-L?activityType=<%= encodeURIComponent('Lista de Compras') %>" class="text-dark">Listas de Compras</a>
                                </td>
                                <td class="text-right px-3 py-2 font-weight-bold"><%= stats.listasCompras %></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos de balanceamento das atividades -->
    <section aria-labelledby="balanceTitle">
        <h2 class="dashboard-section-title" id="balanceTitle">Balanceamento das atividades</h2>
        <div class="row">
            <% charts.forEach((chart) => { %>
                <div class="col-lg-6 mb-4">
                    <%- include('parts/hbar-chart', { chart }) %>
                </div>
            <% }) %>
        </div>
    </section>
</main>

<script src="/scripts/sphere-colors.js" defer></script>
<script src="/scripts/dashboard-charts.js" defer></script>

<%- include('parts/footer') %>
