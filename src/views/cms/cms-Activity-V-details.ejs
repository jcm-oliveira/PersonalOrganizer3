<%#
    Detalhes da atividade: usado na página de visualização (cms-Activity-V) e no
    pop-up de visualização (cms-Activity-V-modal, carregado em /cms-Activity-V/:id/detalhes).
    Organização por afinidade: cabeçalho (o quê + quando), Agenda, Classificação e Anotações.
    Sem style="" inline (bloqueado pela CSP): as cores vêm de data-* e são aplicadas
    por /scripts/sphere-colors.js.
%>
<%
    const relativeDays = (days) => {
        if (days === null || days === undefined) return '';
        if (days === 0) return 'hoje';
        if (days === 1) return 'amanhã';
        if (days === -1) return 'ontem';
        return days > 0 ? `em ${days} dias` : `há ${-days} dias`;
    };
    const timeText = activity.scheduled_time ? activity.scheduled_time.slice(0, 5) : null;
    const periodText = activity.day_period ? activity.day_period.replace(/^\d+\s*-\s*/, '') : null;
%>
<article class="activity-view">
    <!-- Cabeçalho: descrição e bloco da próxima data (com esfera e status) -->
    <header class="av-header">
        <h3 class="av-title"><%= activity.description %></h3>

        <div class="av-next">
            <i class="far fa-calendar-alt av-next__icon" aria-hidden="true"></i>
            <div class="av-next__body">
                <div class="av-next__date">
                    <%= activity.next_activity_date_br || '-' %><% if (timeText) { %> · <%= timeText %><% } %>
                    <span class="badge badge-pill <%= activity.traffic_light_class %> av-next__badge">
                        <%= activity.next_activity_day_label %>
                    </span>
                </div>
                <div class="av-next__hint <%= activity.days_next_activity < 0 ? 'text-danger' : '' %>">
                    Próxima atividade<% if (activity.days_next_activity !== null) { %> · <%= relativeDays(activity.days_next_activity) %><% } %>
                </div>
            </div>
            <!-- Coluna à direita: esfera, status e repetição, alinhados à direita -->
            <div class="av-next__meta">
                <span class="av-sphere">
                    <% if (activity.life_sphere_color) { %>
                        <span class="color-dot" data-bg-color="<%= activity.life_sphere_color %>" aria-hidden="true"></span>
                    <% } %>
                    <%= activity.life_sphere %>
                </span>
                <!-- Status no mesmo padrão neutro da consulta (não compete com o selo do dia) -->
                <span class="badge activity-status-badge">
                    <%= activity.status_name || (activity.status === 1 ? 'Ativo' : 'Inativo') %>
                </span>
                <% if (activity.recurrence_description) { %>
                    <span class="av-recurrent">
                        <i class="fas fa-redo-alt" aria-hidden="true"></i> Recorrente
                    </span>
                <% } %>
            </div>
        </div>
    </header>

    <div class="row">
        <!-- Agenda: quando acontece -->
        <section class="col-lg-6 av-section" aria-labelledby="av-agenda-<%= activity.id %>">
            <h4 class="av-section__title" id="av-agenda-<%= activity.id %>">Agenda</h4>
            <dl class="av-list">
                <div class="av-item">
                    <dt><i class="far fa-clock" aria-hidden="true"></i> Horário</dt>
                    <dd>
                        <%= timeText || 'Sem horário definido' %><% if (periodText) { %>
                            <span class="av-muted">· <%= periodText %></span><% } %>
                    </dd>
                </div>
                <div class="av-item">
                    <dt><i class="far fa-calendar-check" aria-hidden="true"></i> Prazo final</dt>
                    <dd>
                        <% if (activity.final_deadline_br) { %>
                            <%= activity.final_deadline_br %>
                            <span class="av-muted <%= activity.days_final_deadline < 0 ? 'text-danger' : '' %>">
                                · <%= relativeDays(activity.days_final_deadline) %>
                            </span>
                        <% } else { %>
                            <span class="av-muted">Sem prazo final</span>
                        <% } %>
                    </dd>
                </div>
                <div class="av-item">
                    <dt><i class="fas fa-redo-alt" aria-hidden="true"></i> Repetição</dt>
                    <dd>
                        <% if (activity.recurrence_description) { %>
                            <%= activity.recurrence_description %>
                            <% if (activity.next_occurrence_date) { %>
                                <span class="d-block av-muted">
                                    Ocorrência seguinte: <%= activity.next_occurrence_date.split('-').reverse().join('/') %>
                                </span>
                            <% } %>
                        <% } else { %>
                            <span class="av-muted">Não se repete</span>
                        <% } %>
                    </dd>
                </div>
            </dl>
        </section>

        <!-- Classificação: do que se trata -->
        <section class="col-lg-6 av-section" aria-labelledby="av-class-<%= activity.id %>">
            <h4 class="av-section__title" id="av-class-<%= activity.id %>">Classificação</h4>
            <dl class="av-list">
                <div class="av-item">
                    <dt><i class="fas fa-heart" aria-hidden="true"></i> Esfera da Vida</dt>
                    <dd><%= activity.life_sphere %></dd>
                </div>
                <div class="av-item">
                    <dt><i class="fas fa-flag" aria-hidden="true"></i> Relevância</dt>
                    <dd><%= activity.relevance %></dd>
                </div>
                <div class="av-item">
                    <dt><i class="fas fa-layer-group" aria-hidden="true"></i> Tipo de Ação</dt>
                    <dd><%- activity.action_type ? '' : '<span class="av-muted">Não informado</span>' %><%= activity.action_type || '' %></dd>
                </div>
                <div class="av-item">
                    <dt><i class="fas fa-folder" aria-hidden="true"></i> Organização por Tema</dt>
                    <dd><%- activity.theme_organization ? '' : '<span class="av-muted">Não informado</span>' %><%= activity.theme_organization || '' %></dd>
                </div>
            </dl>
        </section>
    </div>

    <!-- Anotações -->
    <section class="av-section av-section--notes" aria-labelledby="av-notes-<%= activity.id %>">
        <h4 class="av-section__title" id="av-notes-<%= activity.id %>">Anotações</h4>
        <% if (activity.notes) { %>
            <p class="mb-0 activity-notes"><%= activity.notes %></p>
        <% } else { %>
            <p class="mb-0 av-muted">Nenhuma anotação registrada.</p>
        <% } %>
    </section>
</article>
