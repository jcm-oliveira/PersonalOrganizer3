<%
    // Itens do menu conforme as permissões do usuário logado (perfis de acesso)
    const canView = (resource) => locals.can && can(resource, 'view');
    const supportItems = [
        { resource: 'life_sphere', href: '/cms-LifeSphere-Q', icon: 'fas fa-heart', label: 'Esfera da Vida' },
        { resource: 'activity_type', href: '/cms-ActivityType-Q', icon: 'fas fa-flag', label: 'Tipo de Atividade' },
        { resource: 'day_period', href: '/cms-DayPeriod-Q', icon: 'fas fa-sun', label: 'Período do Dia' },
        { resource: 'action_type', href: '/cms-ActionType-Q', icon: 'fas fa-layer-group', label: 'Tipo de Ação' },
        { resource: 'theme_organization', href: '/cms-ThemeOrganization-Q', icon: 'fas fa-folder', label: 'Organização por Tema' },
        { resource: 'activity_status', href: '/cms-ActivityStatus-Q', icon: 'fas fa-toggle-on', label: 'Status de Atividade' },
    ].filter((item) => canView(item.resource));
    const accessItems = [
        { resource: 'users', href: '/cms-User-Q', icon: 'fas fa-users', label: 'Usuários' },
        { resource: 'profiles', href: '/cms-AccessProfile-Q', icon: 'fas fa-user-shield', label: 'Perfis de Acesso' },
    ].filter((item) => canView(item.resource));
    const user = locals.currentUser;
    const initials = user
        ? user.name.trim().split(/\s+/).filter(Boolean).map((part) => part[0]).slice(0, 2).join('').toUpperCase()
        : '';
%>
<nav class="navbar navbar-expand-md navbar-dark bg-dark">
    <a class="navbar-brand" href="/">Personal Organizer</a>
    <% if (user) { %>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNavbar"
        aria-controls="mainNavbar" aria-expanded="false" aria-label="Abrir menu">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav mr-auto">
            <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
            <% if (canView('dashboard')) { %>
                <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
            <% } %>
            <% if (canView('activities')) { %>
                <li class="nav-item"><a class="nav-link" href="/cms-Activity-Q">Atividades</a></li>
            <% } %>
            <% if (canView('calendar')) { %>
                <li class="nav-item"><a class="nav-link" href="/cms-Calendar">Calendário</a></li>
            <% } %>
        </ul>

        <!-- Engrenagem (menu de cadastros) e usuário logado -->
        <ul class="navbar-nav align-items-md-center">
            <% if (supportItems.length > 0 || accessItems.length > 0) { %>
            <li class="nav-item dropdown">
                <a class="nav-link nav-settings" href="#" id="cadastrosDropdown" role="button"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                    title="Cadastros" aria-label="Cadastros">
                    <span class="nav-settings__icon"><i class="fas fa-cog" aria-hidden="true"></i></span>
                    <span class="d-md-none">Cadastros</span>
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="cadastrosDropdown">
                    <% supportItems.forEach((item) => { %>
                        <a class="dropdown-item" href="<%= item.href %>">
                            <i class="<%= item.icon %> text-muted mr-2" aria-hidden="true"></i> <%= item.label %>
                        </a>
                    <% }) %>
                    <% if (accessItems.length > 0) { %>
                        <% if (supportItems.length > 0) { %><div class="dropdown-divider"></div><% } %>
                        <h6 class="dropdown-header">Acesso</h6>
                        <% accessItems.forEach((item) => { %>
                            <a class="dropdown-item" href="<%= item.href %>">
                                <i class="<%= item.icon %> text-muted mr-2" aria-hidden="true"></i> <%= item.label %>
                            </a>
                        <% }) %>
                    <% } %>
                </div>
            </li>
            <% } %>
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle nav-user" href="#" id="userDropdown" role="button"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <% if (user.photo_file) { %>
                        <img class="nav-user__avatar" src="/cms-User/<%= user.id %>/foto?v=<%= user.photo_file.slice(0, 8) %>" alt="">
                    <% } else { %>
                        <span class="nav-user__avatar nav-user__avatar--initials" aria-hidden="true"><%= initials %></span>
                    <% } %>
                    <span class="nav-user__name"><%= user.name %></span>
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                    <div class="dropdown-item-text small">
                        <div class="font-weight-bold text-dark"><%= user.name %></div>
                        <div class="text-muted"><%= user.email %></div>
                        <% if (user.profileNames.length > 0) { %>
                            <div class="text-muted mt-1"><i class="fas fa-user-shield mr-1" aria-hidden="true"></i><%= user.profileNames.join(', ') %></div>
                        <% } %>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="/minha-conta/senha">
                        <i class="fas fa-key text-muted mr-2" aria-hidden="true"></i> Alterar minha senha
                    </a>
                    <form method="post" action="/logout" class="m-0">
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-sign-out-alt text-muted mr-2" aria-hidden="true"></i> Sair
                        </button>
                    </form>
                </div>
            </li>
        </ul>
    </div>
    <% } %>
</nav>
