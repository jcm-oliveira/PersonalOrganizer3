# Copie para .env e ajuste. O .env nunca vai para o Git.
NODE_ENV=development
PORT=3000

# Usuário dedicado da aplicação, nunca root (docs/ARQUITETURA.md, seção 13.1)
DATABASE_URL=mysql://app_user:troque-esta-senha@localhost:3306/novo

# Usadas apenas pelo docker-compose.yml para criar o banco e o usuário
DB_NAME=novo
DB_USER=app_user
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
