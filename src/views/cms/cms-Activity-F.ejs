<%#
    Filtro das telas de consulta (com farol): tela Todas as Atividades e bloco Atividades
    Programadas da consulta. Opcionais:
    - listBaseUrl: tela que recebe o filtro (padrão: consulta por blocos)
    - modalId / modalTitle: identificação do pop-up (um por bloco na consulta)
    - hideActivityType: sem o campo Tipo de Atividade (o bloco já é de um tipo)
    - preserve: [[nome, valor]] dos filtros/páginas dos outros blocos, mantidos ao aplicar
    - clearUrl: destino do "Limpar"
%>
<%
    const filterBaseUrl = locals.listBaseUrl || '/cms-Activity-Q';
    const filterModalId = locals.modalId || 'filterModal';
    const showActivityTypeField = locals.hideActivityType !== true;
%>
<div class="modal fade" id="<%= filterModalId %>" tabindex="-1" role="dialog" aria-labelledby="<%= filterModalId %>Title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <form class="modal-content" method="get" action="<%= filterBaseUrl %>">
            <% (locals.preserve || []).forEach(([name, value]) => { %>
                <input type="hidden" name="<%= name %>" value="<%= value %>">
            <% }) %>
            <div class="modal-header">
                <h5 class="modal-title" id="<%= filterModalId %>Title"><%= locals.modalTitle || 'Filtrar Atividades' %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group col-md-8">
                        <label for="filterSearch">Descrição, Tema ou Código</label>
                        <input type="text" class="form-control" id="filterSearch" name="search" maxlength="150"
                            placeholder="Buscar por texto ou código..." value="<%= filter.search %>">
                    </div>
                    <div class="form-group col-md-4">
                        <label for="filterStatus">Status</label>
                        <select class="form-control" id="filterStatus" name="status">
                            <option value="visible" <%= filter.status === "visible" ? "selected" : "" %>>Visíveis por padrão</option>
                            <option value="all" <%= filter.status === "all" ? "selected" : "" %>>Todos os Status</option>
                            <% if (typeof activityStatuses !== 'undefined' && activityStatuses.length > 0) { %>
                                <optgroup label="Status de Atividade">
                                    <% activityStatuses.forEach((st) => { %>
                                        <option value="<%= st.id %>" <%= String(filter.status) === String(st.id) ? "selected" : "" %>>
                                            <%= st.name %>
                                        </option>
                                    <% }) %>
                                </optgroup>
                            <% } %>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="filterLifeSphere">Esfera da Vida</label>
                        <select class="form-control" id="filterLifeSphere" name="lifeSphere">
                            <option value="">Todas</option>
                            <% lifeSpheres.forEach((sphere) => { %>
                                <option value="<%= sphere %>" <%= filter.lifeSphere === sphere ? "selected" : "" %>><%= sphere %></option>
                            <% }) %>
                        </select>
                    </div>
                    <%#
                        Ao lado da Esfera: Tipo de Atividade (quando há o campo) ou Tipo de Ação,
                        para não sobrar espaço vazio na linha
                    %>
                    <div class="form-group col-md-6">
                        <% if (showActivityTypeField) { %>
                        <label for="filterActivityType">Tipo de Atividade</label>
                        <select class="form-control" id="filterActivityType" name="activityType">
                            <option value="">Todas</option>
                            <% activityTypeOptions.forEach((rel) => { %>
                                <option value="<%= rel %>" <%= filter.activityType === rel ? "selected" : "" %>><%= rel %></option>
                            <% }) %>
                        </select>
                        <% } else { %>
                        <label for="filterActionType">Tipo de Ação</label>
                        <select class="form-control" id="filterActionType" name="actionType">
                            <option value="">Todos</option>
                            <% actionTypes.forEach((actType) => { %>
                                <option value="<%= actType %>" <%= filter.actionType === actType ? "selected" : "" %>><%= actType %></option>
                            <% }) %>
                        </select>
                        <% } %>
                    </div>
                </div>

                <%# Última linha sempre completa: (Tipo de Ação) + Farol + Itens por página %>
                <div class="form-row">
                    <% if (showActivityTypeField) { %>
                    <div class="form-group col-md-4">
                        <label for="filterActionType">Tipo de Ação</label>
                        <select class="form-control" id="filterActionType" name="actionType">
                            <option value="">Todos</option>
                            <% actionTypes.forEach((actType) => { %>
                                <option value="<%= actType %>" <%= filter.actionType === actType ? "selected" : "" %>><%= actType %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div class="form-group <%= showActivityTypeField ? 'col-md-5' : 'col-md-8' %>">
                        <label for="filterTrafficLight">Farol / Vencimento</label>
                        <select class="form-control" id="filterTrafficLight" name="trafficLight">
                            <option value="">Todos</option>
                            <option value="ATRASADA" <%= filter.trafficLight === "ATRASADA" ? "selected" : "" %>>Atrasadas</option>
                            <option value="HOJE" <%= filter.trafficLight === "HOJE" ? "selected" : "" %>>Vence Hoje</option>
                            <option value="7_DIAS" <%= filter.trafficLight === "7_DIAS" ? "selected" : "" %>>Próximos 7 dias</option>
                            <option value="15_DIAS" <%= filter.trafficLight === "15_DIAS" ? "selected" : "" %>>Entre 7 e 15 dias</option>
                            <option value="PRAZO" <%= filter.trafficLight === "PRAZO" ? "selected" : "" %>>Prazo Final em 7 dias</option>
                        </select>
                    </div>
                    <div class="form-group <%= showActivityTypeField ? 'col-md-3' : 'col-md-4' %>">
                        <label for="filterPerPage">Itens por página</label>
                        <select class="form-control" id="filterPerPage" name="perPage">
                            <% pageSizes.forEach((size) => { %>
                                <option value="<%= size %>" <%= filter.perPage === size ? "selected" : "" %>><%= size %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-link" href="<%= locals.clearUrl || filterBaseUrl %>">Limpar</a>
                <button type="submit" class="btn btn-primary">Aplicar Filtros</button>
            </div>
        </form>
    </div>
</div>
