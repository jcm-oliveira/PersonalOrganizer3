<%- include('parts/head') %>
<%
    // Atalhos conforme as permissões do usuário logado (perfis de acesso)
    const sections = [
        {
            title: 'Gestão',
            col: 'col-md-4 mb-3',
            items: [
                { resource: 'activities', href: '/cms-Activity-Q', icon: 'fas fa-tasks', title: 'Atividades',
                  text: 'Cadastre e acompanhe atividades, prazos, farol de vencimento e prioridades.' },
                { resource: 'calendar', href: '/cms-Calendar', icon: 'far fa-calendar-alt', title: 'Calendário',
                  text: 'Veja as atividades e prazos finais por mês, semana ou lista e remarque arrastando.' },
                { resource: 'dashboard', href: '/dashboard', icon: 'fas fa-chart-pie', title: 'Dashboard',
                  text: 'Veja os indicadores e o quadrante com status e prazos das atividades.' },
            ],
        },
        {
            title: 'Cadastros de Apoio',
            col: 'col-md-4 col-sm-6 mb-3',
            items: [
                { resource: 'life_sphere', href: '/cms-LifeSphere-Q', icon: 'fas fa-heart', title: 'Esferas da Vida',
                  text: 'Áreas da vida e cores de destaque.' },
                { resource: 'activity_type', href: '/cms-ActivityType-Q', icon: 'fas fa-flag', title: 'Tipos de Atividade',
                  text: 'Classificação das atividades (ex.: prioridade, backlog).' },
                { resource: 'day_period', href: '/cms-DayPeriod-Q', icon: 'fas fa-sun', title: 'Períodos do Dia',
                  text: 'Manhã, tarde ou noite.' },
                { resource: 'action_type', href: '/cms-ActionType-Q', icon: 'fas fa-layer-group', title: 'Tipos de Ação',
                  text: 'Natureza de execução da atividade.' },
                { resource: 'theme_organization', href: '/cms-ThemeOrganization-Q', icon: 'fas fa-folder', title: 'Organização por Tema',
                  text: 'Agrupadores vinculados às esferas.' },
                { resource: 'activity_status', href: '/cms-ActivityStatus-Q', icon: 'fas fa-toggle-on', title: 'Status de Atividade',
                  text: 'Situações de fluxo, cores e visibilidade padrão.' },
            ],
        },
        {
            title: 'Acesso ao Sistema',
            col: 'col-md-4 col-sm-6 mb-3',
            items: [
                { resource: 'users', href: '/cms-User-Q', icon: 'fas fa-users', title: 'Usuários',
                  text: 'Pessoas com acesso ao sistema, foto e perfis de acesso.' },
                { resource: 'profiles', href: '/cms-AccessProfile-Q', icon: 'fas fa-user-shield', title: 'Perfis de Acesso',
                  text: 'Permissões por tela: visualizar, inserir, alterar e excluir.' },
            ],
        },
    ]
        .map((section) => ({ ...section, items: section.items.filter((item) => can(item.resource, 'view')) }))
        .filter((section) => section.items.length > 0);
%>

<main class="container py-5">
    <%# Cabeçalho: logo 7lifes, com o slogan abaixo %>
    <header class="home-header">
        <img class="home-logo" src="/images/logo-7lifes.svg" alt=""
            width="88" height="88">
        <div>
            <h1 class="home-title brand-name">7lifes</h1>
            <p class="lead text-muted mb-0 brand-slogan">Your personal organizer</p>
        </div>
    </header>

    <%# Acesso rápido aos módulos que o usuário pode usar %>
    <nav class="mt-5" aria-label="Acesso rápido">
        <% if (sections.length === 0) { %>
            <div class="alert alert-info">
                Seu usuário ainda não tem acesso a nenhuma tela. Fale com um administrador do sistema.
            </div>
        <% } %>
        <% sections.forEach((section, index) => { %>
            <h2 class="dashboard-section-title <%= index > 0 ? 'mt-4' : '' %>"><%= section.title %></h2>
            <div class="row">
                <% section.items.forEach((item) => { %>
                    <div class="<%= section.col %>">
                        <a class="card dashboard-shortcut h-100" href="<%= item.href %>">
                            <div class="card-body">
                                <span class="dashboard-shortcut-icon" aria-hidden="true">
                                    <i class="<%= item.icon %>"></i>
                                </span>
                                <span class="dashboard-shortcut-title"><%= item.title %></span>
                                <span class="dashboard-shortcut-text"><%= item.text %></span>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>
        <% }) %>
    </nav>
</main>

<%- include('parts/footer') %>
