<!-- Pop-up "Concluir ocorrência": avança uma atividade recorrente para a próxima ocorrência (preenchido por /scripts/activity-quick-actions.js) -->
<div class="modal fade" id="occurrenceModal" tabindex="-1" role="dialog" aria-labelledby="occurrenceModalTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form class="modal-content" method="post" action="" data-action-prefix="/cms-Activity-O/">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <div class="modal-header">
                <h5 class="modal-title" id="occurrenceModalTitle">
                    <i class="fas fa-check text-muted mr-1" aria-hidden="true"></i> Concluir ocorrência
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    Atividade nº <strong data-field="activity-id"></strong> –
                    <span data-field="activity-description"></span>
                </p>
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted font-weight-normal">Repetição</dt>
                    <dd class="col-7" data-field="recurrence"></dd>
                    <dt class="col-5 text-muted font-weight-normal">Ocorrência concluída</dt>
                    <dd class="col-7" data-field="current-date"></dd>
                    <dt class="col-5 text-muted font-weight-normal">Próxima ocorrência</dt>
                    <dd class="col-7 font-weight-bold mb-0" data-field="next-occurrence"></dd>
                </dl>
                <input type="hidden" name="returnTo" value="<%= returnTo %>">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success">Concluir e avançar</button>
            </div>
        </form>
    </div>
</div>
