<%- include('parts/head') %>

<main class="container py-5">
    <%# Cabeçalho: logo da Congregação Cristã no Brasil e o nome do departamento %>
    <header class="home-header">
        <img class="home-logo" src="/images/logo-ccb.png" alt="Congregação Cristã no Brasil"
            width="1114" height="576">
        <div>
            <h1 class="home-title">DSA - Departamento de Suporte Administrativo</h1>
            <p class="lead text-muted mb-0">Planejamento Estratégico e Gestão para Brasil e Exterior</p>
        </div>
    </header>

    <%# Aviso de uso: plataforma restrita e com informações sigilosas %>
    <aside class="home-disclaimer" role="note" aria-label="Aviso de uso da plataforma">
        <i class="fas fa-lock home-disclaimer-icon" aria-hidden="true"></i>
        <div>
            <p>
                Esta plataforma é de uso exclusivo e tem como objetivo oferecer ao corpo diretivo da
                Congregação visibilidade sobre a execução do planejamento e a gestão dos projetos
                estratégicos que a norteiam.
            </p>
            <p>
                Ela contém informações sigilosas, e o acesso é restrito aos grupos de trabalho
                responsáveis por definir normas e diretrizes aplicáveis a todo o Brasil e ao exterior.
            </p>
            <p>
                Grupos estaduais, regionais ou locais devem consultar as informações disponíveis na
                Intranet.
            </p>
        </div>
    </aside>

    <%# Acesso rápido aos módulos (Gestão) %>
    <nav class="mt-5" aria-label="Acesso rápido">
        <h2 class="dashboard-section-title">Gestão</h2>
        <div class="row">
            <div class="col-md-6 col-lg-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-Activity-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-tasks"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Atividades</span>
                        <span class="dashboard-shortcut-text">
                            Cadastre e acompanhe atividades, prazos, farol de vencimento e prioridades.
                        </span>
                    </div>
                </a>
            </div>

            <div class="col-md-6 col-lg-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/dashboard">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-chart-pie"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Dashboard</span>
                        <span class="dashboard-shortcut-text">
                            Veja os indicadores e o quadrante com status e prazos das atividades.
                        </span>
                    </div>
                </a>
            </div>
        </div>
    </nav>
</main>

<%- include('parts/footer') %>
