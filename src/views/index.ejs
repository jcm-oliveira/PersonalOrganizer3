<%- include('parts/head') %>

<main class="container py-5">
    <%# Cabeçalho: logo Personal Organizer %>
    <header class="home-header">
        <img class="home-logo" src="/images/logo-personal-organizer.svg" alt="Personal Organizer 3.0"
            width="88" height="88">
        <div>
            <h1 class="home-title">Personal Organizer 3.0</h1>
            <p class="lead text-muted mb-0">Vida organizada, mente saudável.</p>
        </div>
    </header>

    <%# Acesso rápido aos módulos (Gestão e Cadastros) %>
    <nav class="mt-5" aria-label="Acesso rápido">
        <h2 class="dashboard-section-title">Gestão</h2>
        <div class="row">
            <div class="col-md-4 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-Activity-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-tasks"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Atividades</span>
                        <span class="dashboard-shortcut-text">
                            Cadastre e acompanhe atividades, prazos, farol de vencimento e prioridades.
                        </span>
                    </div>
                </a>
            </div>

            <div class="col-md-4 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-Calendar">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="far fa-calendar-alt"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Calendário</span>
                        <span class="dashboard-shortcut-text">
                            Veja as atividades e prazos finais por mês, semana ou lista e remarque arrastando.
                        </span>
                    </div>
                </a>
            </div>

            <div class="col-md-4 mb-3">
                <a class="card dashboard-shortcut h-100" href="/dashboard">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-chart-pie"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Dashboard</span>
                        <span class="dashboard-shortcut-text">
                            Veja os indicadores e o quadrante com status e prazos das atividades.
                        </span>
                    </div>
                </a>
            </div>
        </div>

        <h2 class="dashboard-section-title mt-4">Cadastros de Apoio</h2>
        <div class="row">
            <div class="col-md-4 col-sm-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-LifeSphere-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-heart"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Esferas da Vida</span>
                        <span class="dashboard-shortcut-text">Áreas da vida e cores de destaque.</span>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-Relevance-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-flag"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Relevâncias</span>
                        <span class="dashboard-shortcut-text">Níveis de prioridade das tarefas.</span>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-DayPeriod-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-sun"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Períodos do Dia</span>
                        <span class="dashboard-shortcut-text">Manhã, tarde ou noite.</span>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-Periodicity-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-redo-alt"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Periodicidades</span>
                        <span class="dashboard-shortcut-text">Frequência e repetição.</span>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-ActionType-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-layer-group"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Tipos de Ação</span>
                        <span class="dashboard-shortcut-text">Natureza de execução da atividade.</span>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-ThemeOrganization-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-folder"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Organização por Tema</span>
                        <span class="dashboard-shortcut-text">Agrupadores vinculados às esferas.</span>
                    </div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <a class="card dashboard-shortcut h-100" href="/cms-ActivityStatus-Q">
                    <div class="card-body">
                        <span class="dashboard-shortcut-icon" aria-hidden="true">
                            <i class="fas fa-toggle-on"></i>
                        </span>
                        <span class="dashboard-shortcut-title">Status de Atividade</span>
                        <span class="dashboard-shortcut-text">Situações de fluxo, cores e visibilidade padrão.</span>
                    </div>
                </a>
            </div>
        </div>
    </nav>
</main>

<%- include('parts/footer') %>
