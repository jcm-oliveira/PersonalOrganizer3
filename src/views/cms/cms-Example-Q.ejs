<%- include('../parts/head') %>

<main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Exemplos</h1>
        <div>
            <button type="button" class="btn btn-outline-secondary" data-toggle="modal" data-target="#filterModal">
                Filtrar
            </button>
            <a class="btn btn-primary" href="/cms-Example-C">Novo</a>
        </div>
    </div>

    <%- include('../parts/messages') %>

    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nome</th>
                <th scope="col">Status</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            <% if (examples.length === 0) { %>
                <tr>
                    <td colspan="4" class="text-center text-muted">Nenhum registro encontrado.</td>
                </tr>
            <% } %>
            <% examples.forEach((example) => { %>
                <tr>
                    <td><%= example.id %></td>
                    <td><%= example.name %></td>
                    <td><%= example.status === 1 ? "Ativo" : "Inativo" %></td>
                    <td class="text-right">
                        <a class="btn btn-sm btn-outline-primary" href="/cms-Example-C/<%= example.id %>">Editar</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <nav class="d-flex justify-content-between align-items-center" aria-label="Paginação">
        <span class="text-muted small">
            Exibindo <%= pagination.firstItem %>–<%= pagination.lastItem %> de <%= pagination.total %> registros
        </span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pagination.previousUrl ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.previousUrl || '#' %>">Anterior</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página <%= pagination.page %> de <%= pagination.totalPages %></span>
            </li>
            <li class="page-item <%= pagination.nextUrl ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.nextUrl || '#' %>">Próxima</a>
            </li>
        </ul>
    </nav>

    <%- include('cms-Example-F') %>
</main>

<%- include('../parts/footer') %>
