<%- include('../parts/head') %>

<main class="container-fluid py-4 px-lg-5">
    <!-- Barra de Ações (Filtros e Novo) -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-0 text-dark">Atividades</h1>
            <% if (filter.trafficLight || filter.search || filter.lifeSphere || filter.relevance || filter.actionType || filter.status !== '1') { %>
                <span class="badge badge-info mt-1">Filtros aplicados</span>
                <a href="/cms-Activity-Q" class="small text-danger ml-2">Limpar filtros</a>
            <% } %>
        </div>
        <div>
            <button type="button" class="btn btn-outline-secondary" data-toggle="modal" data-target="#filterModal">
                Filtrar
            </button>
            <a class="btn btn-primary" href="/cms-Activity-C">Nova Atividade</a>
        </div>
    </div>

    <%- include('../parts/messages') %>

    <!-- Tabela Estilo Planilha / Painel de Vôo -->
    <div class="table-responsive shadow-sm bg-white rounded">
        <table class="table table-sm table-bordered table-hover mb-0">
            <thead class="thead-light">
                <!-- Linha superior de agrupamento de cabeçalho -->
                <tr class="text-center font-weight-bold">
                    <th colspan="5" class="bg-light border-bottom text-left px-3 text-secondary">INFORMAÇÕES OBRIGATÓRIAS</th>
                    <th colspan="5" class="bg-light border-bottom text-left px-3 text-secondary">INFORMAÇÕES COMPLEMENTARES</th>
                    <th colspan="1" class="bg-light border-bottom text-secondary">STATUS</th>
                    <th colspan="3" class="bg-light border-bottom text-secondary">FAROL</th>
                    <th colspan="1" class="bg-light border-bottom text-secondary">AÇÕES</th>
                </tr>
                <!-- Linha inferior de colunas específicas -->
                <tr class="text-center">
                    <th style="min-width: 140px;">Esfera da Vida</th>
                    <th style="min-width: 220px;" class="text-left">Descrição</th>
                    <th style="min-width: 100px;">Relevância</th>
                    <th style="min-width: 110px;">Próxima Atividade</th>
                    <th style="min-width: 100px;">Prazo Final</th>

                    <th style="min-width: 110px;">Período do dia</th>
                    <th style="min-width: 80px;">Horário</th>
                    <th style="min-width: 100px;">Periodicidade</th>
                    <th style="min-width: 120px;">Tipo de Ação</th>
                    <th style="min-width: 160px;">Organização por tema</th>

                    <th style="min-width: 80px;">Status</th>
                    <th style="min-width: 70px;">Dias próx.</th>
                    <th style="min-width: 70px;">Dias prazo</th>
                    <th style="min-width: 120px;">Farol Próx.</th>
                    <th style="min-width: 110px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (activities.length === 0) { %>
                    <tr>
                        <td colspan="15" class="text-center py-4 text-muted">
                            Nenhuma atividade encontrada com os filtros selecionados.
                        </td>
                    </tr>
                <% } %>
                <% activities.forEach((act) => { 
                    const isOverdue = act.traffic_light === 'ATRASADA';
                    const rowClass = isOverdue ? 'table-danger' : '';
                %>
                    <tr class="<%= rowClass %>">
                        <!-- Esfera da Vida -->
                        <td class="align-middle">
                            <%= act.life_sphere %>
                        </td>

                        <!-- Descrição (destaque em negrito) -->
                        <td class="align-middle text-left font-weight-bold">
                            <a href="/cms-Activity-V/<%= act.id %>" class="text-dark">
                                <%= act.description %>
                            </a>
                        </td>

                        <!-- Relevância -->
                        <td class="align-middle text-center">
                            <%= act.relevance %>
                        </td>

                        <!-- Próxima Atividade -->
                        <td class="align-middle text-center">
                            <%= act.next_activity_date_formatted || '-' %>
                        </td>

                        <!-- Prazo Final -->
                        <td class="align-middle text-center">
                            <%= act.final_deadline_formatted || '-' %>
                        </td>

                        <!-- Período do dia -->
                        <td class="align-middle text-center">
                            <%= act.day_period || '-' %>
                        </td>

                        <!-- Horário -->
                        <td class="align-middle text-center">
                            <%= act.scheduled_time ? act.scheduled_time.slice(0, 5) : '-' %>
                        </td>

                        <!-- Periodicidade -->
                        <td class="align-middle text-center">
                            <%= act.periodicity || '-' %>
                        </td>

                        <!-- Tipo de Ação -->
                        <td class="align-middle text-center">
                            <%= act.action_type || '-' %>
                        </td>

                        <!-- Organização por tema -->
                        <td class="align-middle text-center">
                            <%= act.theme_organization || '-' %>
                        </td>

                        <!-- Status -->
                        <td class="align-middle text-center">
                            <%= act.status === 1 ? 'Ativo' : 'Inativo' %>
                        </td>

                        <!-- Dias Próx. Atividade com indicador circular (dot) -->
                        <td class="align-middle text-center">
                            <span class="d-inline-block rounded-circle mr-1" style="width: 8px; height: 8px; background-color: <%= act.traffic_light_dot_color %>;"></span>
                            <%= act.days_next_activity !== null ? act.days_next_activity : '-' %>
                        </td>

                        <!-- Dias Prazo Final -->
                        <td class="align-middle text-center">
                            <%= act.days_final_deadline !== null ? act.days_final_deadline : '-' %>
                        </td>

                        <!-- Farol Próx. Atividade (destaque com badge) -->
                        <td class="align-middle text-center font-weight-bold">
                            <span class="badge <%= act.traffic_light_class %>">
                                <%= act.traffic_light_label %>
                            </span>
                        </td>

                        <!-- Ações -->
                        <td class="align-middle text-center text-nowrap">
                            <a class="btn btn-sm btn-outline-info py-0 px-2" href="/cms-Activity-V/<%= act.id %>" title="Visualizar">
                                Ver
                            </a>
                            <a class="btn btn-sm btn-outline-primary py-0 px-2" href="/cms-Activity-C/<%= act.id %>" title="Editar">
                                Editar
                            </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Paginação -->
    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginação">
        <span class="text-muted small">
            Exibindo <%= pagination.firstItem %>–<%= pagination.lastItem %> de <%= pagination.total %> registros
        </span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pagination.previousUrl ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.previousUrl || '#' %>">Anterior</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página <%= pagination.page %> de <%= pagination.totalPages %></span>
            </li>
            <li class="page-item <%= pagination.nextUrl ? '' : 'disabled' %>">
                <a class="page-link" href="<%= pagination.nextUrl || '#' %>">Próxima</a>
            </li>
        </ul>
    </nav>

    <!-- Modal de Filtros -->
    <%- include('cms-Activity-F') %>
</main>

<%- include('../parts/footer') %>
