<%# Campos do formulário, compartilhados por cms-Example-C e cms-Example-U %>
<div class="form-row">
    <div class="form-group col-md-9">
        <label for="name">Nome</label>
        <input type="text" class="form-control <%= errors.name ? 'is-invalid' : '' %>" id="name" name="name"
            maxlength="150" value="<%= values.name %>" required autofocus>
        <% if (errors.name) { %><div class="invalid-feedback"><%= errors.name %></div><% } %>
    </div>
    <div class="form-group col-md-3">
        <label for="status">Status</label>
        <select class="form-control <%= errors.status ? 'is-invalid' : '' %>" id="status" name="status">
            <option value="1" <%= values.status === "1" ? "selected" : "" %>>Ativo</option>
            <option value="0" <%= values.status === "0" ? "selected" : "" %>>Inativo</option>
        </select>
        <% if (errors.status) { %><div class="invalid-feedback"><%= errors.status %></div><% } %>
    </div>
</div>
<div class="form-group">
    <label for="description">Descrição</label>
    <textarea class="form-control <%= errors.description ? 'is-invalid' : '' %>" id="description"
        name="description" rows="4" maxlength="5000"><%= values.description %></textarea>
    <% if (errors.description) { %><div class="invalid-feedback"><%= errors.description %></div><% } %>
</div>
