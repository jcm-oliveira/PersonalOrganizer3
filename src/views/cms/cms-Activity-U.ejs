<%- include('../parts/head') %>

<main class="container py-4">
    <form method="post" action="/cms-Activity-U/<%= activityId %>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">Editar Atividade nº <%= activityId %></h1>
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-sm btn-outline-danger mr-1" data-toggle="modal" data-target="#deleteModal"
                    title="Excluir Atividade" aria-label="Excluir Atividade">
                    <i class="fas fa-trash-alt mr-1" aria-hidden="true"></i> Excluir
                </button>
                <a class="btn btn-sm btn-outline-secondary mr-1" href="/cms-Activity-V/<%= activityId %>"
                    title="Visualizar Atividade" aria-label="Visualizar Atividade">
                    <i class="fas fa-search mr-1" aria-hidden="true"></i> Visualizar
                </a>
                <button type="submit" class="btn btn-sm btn-primary mr-1"
                    title="Salvar Alterações" aria-label="Salvar Alterações">
                    <i class="fas fa-save mr-1" aria-hidden="true"></i> Salvar
                </button>
                <a class="btn btn-sm btn-outline-secondary" href="/cms-Activity-Q"
                    title="Voltar à Lista" aria-label="Voltar à Lista">
                    <i class="fas fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
                </a>
            </div>
        </div>

        <%- include('cms-Activity-I') %>
    </form>

    <%- include('cms-Activity-D') %>
</main>

<%- include('../parts/footer') %>
